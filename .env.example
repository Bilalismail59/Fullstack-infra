# === Base de données ===
DB_NAME=wordpress_prod
DB_USER=wp_user
DB_PASSWORD=changement

# === Application Flask ===
SECRET_KEY=votre-secret-key
JWT_SECRET_KEY=your-jwt-secret-key
APP_VERSION=1.0.0

# === Redis ===
REDIS_PASSWORD=

# === Monitoring ===
GRAFANA_PASSWORD=changement

# === SSL / Traefik / ACME ===
ACME_EMAIL=admin@example.com

# === Backup ===
BACKUP_RETENTION_DAYS=30

# === Alertmanager SMTP (envoi de mails) ===
SMTP_SMARTHOST=smtp.gmail.com:587
SMTP_FROM=you@example.com
SMTP_USERNAME=you@example.com
SMTP_PASSWORD=changement

# === Destinataires des alertes ===
CRITICAL_EMAIL_TO=admin@example.com
WARNING_EMAIL_TO=ops@example.com
PREPROD_EMAIL_TO=dev-team@example.com

# === Webhooks Alertmanager (optionnel) ===
ALERT_WEBHOOK_URL=http://localhost:5001/
SLACK_WEBHOOK_CRITICAL=https://hooks.slack.com/services/XXXX/YYYY/ZZZZ
